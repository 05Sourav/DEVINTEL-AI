APP_NAME=DevIntel AI
DEBUG=false
SECRET_KEY=your-super-secret-key-change-in-production

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/devintel

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=devintel_chunks

# AI Provider: openai | gemini
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=

# Embedding + Chat models
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
VECTOR_SIZE=1536

# GitHub (optional — increases rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Retrieval tuning
TOP_K_SEMANTIC=10
TOP_K_KEYWORD=5
TOP_K_RERANKED=5
